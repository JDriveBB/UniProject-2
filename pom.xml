<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>co.uniproject</groupId>
    <artifactId>uniproject</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>UniProject</name>

    <properties>
        <java.version>25</java.version>
        <telegrambots.version>10.3.0</telegrambots.version>
        <networknt-json-schema-validator.version>3.0.8</networknt-json-schema-validator.version>
    </properties>

    <modules>
        <module>eventos-contrato</module>
        <module>nucleo</module>
        <module>agente-telegram</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>co.uniproject</groupId>
                <artifactId>eventos-contrato</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots-longpolling</artifactId>
                <version>${telegrambots.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots-client</artifactId>
                <version>${telegrambots.version}</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${networknt-json-schema-validator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
