# Copia este archivo como .env y cambia TODOS los valores "cambiar...".
# .env nunca se sube a git. Contraseñas: solo letras y números, 24 caracteres o más.
# Generar una (PowerShell 7):  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
# Generar una (bash):          openssl rand -hex 24

TZ=America/Bogota

# PostgreSQL: superusuario (solo administración) y roles de cada aplicación
POSTGRES_PASSWORD=cambiarPostgres000000000000
NUCLEO_DB_PASSWORD=cambiarNucleoDb0000000000000
AGENTE_DB_PASSWORD=cambiarAgenteDb0000000000000

# RabbitMQ: administrador del panel (http://localhost:15672) y usuarios de las aplicaciones
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=cambiarRabbitAdmin0000000000
RABBITMQ_NUCLEO_PASSWORD=cambiarRabbitNucleo000000000
RABBITMQ_AGENTE_PASSWORD=cambiarRabbitAgente000000000

# Telegram (BotFather). Vacíos se aceptan en el bloque 1; el bloque del agente los exige.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Secreto compartido núcleo <-> agente para /interno/** (D7)
UNIPROJECT_TOKEN_INTERNO=cambiarTokenInterno0000000000000000

# URL pública de la aplicación web (se usa en los avisos)
UNIPROJECT_URL_BASE=http://localhost:8080

# V1: false mientras UNIPROJECT_URL_BASE sea localhost (Telegram no acepta ese botón)
UNIPROJECT_TELEGRAM_BOTON_ENLACE=false
