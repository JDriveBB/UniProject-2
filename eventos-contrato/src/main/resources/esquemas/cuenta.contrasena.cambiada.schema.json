{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cuenta.contrasena.cambiada",
  "description": "Contraseña cambiada desde el perfil o con un enlace de recuperación (bloque 28). Aviso de seguridad al titular; nunca lleva la contraseña. CloudEvent 1.0 publicado por el núcleo en uniproject.eventos con clave de enrutamiento cuenta.contrasena.cambiada.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "#/definitions/uuid" },
    "source": { "const": "/uniproject/nucleo" },
    "type": { "const": "cuenta.contrasena.cambiada" },
    "time": { "$ref": "#/definitions/instante" },
    "datacontenttype": { "const": "application/json" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titular", "fecha", "origen"],
      "properties": {
        "titular": { "$ref": "#/definitions/persona" },
        "fecha": { "$ref": "#/definitions/instante" },
        "origen": { "enum": ["PERFIL", "RECUPERACION"] }
      }
    }
  },
  "definitions": {
    "id": { "type": "integer", "minimum": 1 },
    "texto": { "type": "string", "minLength": 1, "maxLength": 200 },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "instante": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "nombre": { "$ref": "#/definitions/texto" },
        "chatId": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
