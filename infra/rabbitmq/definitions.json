{
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    { "name": "uniproject.eventos", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "uniproject.no_enrutados", "vhost": "/", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "uniproject.fallidos", "vhost": "/", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "notificaciones.telegram", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "notificaciones.telegram.fallidos", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "no_enrutados", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } }
  ],
  "bindings": [
    { "source": "uniproject.eventos", "vhost": "/", "destination": "notificaciones.telegram", "destination_type": "queue", "routing_key": "#", "arguments": {} },
    { "source": "uniproject.no_enrutados", "vhost": "/", "destination": "no_enrutados", "destination_type": "queue", "routing_key": "", "arguments": {} },
    { "source": "uniproject.fallidos", "vhost": "/", "destination": "notificaciones.telegram.fallidos", "destination_type": "queue", "routing_key": "", "arguments": {} }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "uniproject-eventos-alterno",
      "pattern": "^uniproject\\.eventos$",
      "apply-to": "exchanges",
      "priority": 10,
      "definition": { "alternate-exchange": "uniproject.no_enrutados" }
    },
    {
      "vhost": "/",
      "name": "notificaciones-telegram-reintentos",
      "pattern": "^notificaciones\\.telegram$",
      "apply-to": "queues",
      "priority": 10,
      "definition": {
        "delivery-limit": 20,
        "dead-letter-exchange": "uniproject.fallidos",
        "delayed-retry-type": "failed",
        "delayed-retry-min": 10000,
        "delayed-retry-max": 300000
      }
    }
  ]
}
